{
  "name": "memi-board",
  "version": "0.5.0",
  "type": "module",
  "description": "Firebase 게시판 — core composable + thin Nuxt module(UI SFC). Nuxt 4 + Nuxt UI 호스트에 붙임",
  "license": "MIT",
  "author": "fkkmemi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fkkmemi/memi-board.git"
  },
  "bugs": {
    "url": "https://github.com/fkkmemi/memi-board/issues"
  },
  "homepage": "https://github.com/fkkmemi/memi-board#readme",
  "keywords": [
    "vue",
    "nuxt",
    "firebase",
    "firestore",
    "board",
    "community",
    "nuxt-ui"
  ],
  "sideEffects": [
    "**/*.vue",
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nuxt": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "prepack": "pnpm build",
    "build": "node scripts/build.mjs",
    "build:watch": "vite build --watch",
    "dev": "pnpm build && nuxi dev playground",
    "dev:build": "pnpm build && nuxi build playground",
    "dev:prepare": "pnpm build && nuxi prepare playground",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.0.0",
    "@tiptap/core": ">=2.0.0",
    "@tiptap/pm": ">=2.0.0",
    "firebase": "^12.0.0",
    "nuxt": ">=3.0.0 || >=4.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.0.0 || ^5.0.0",
    "vuefire": "^3.2.3"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    },
    "@nuxt/ui": {
      "optional": true
    },
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/ui": "^4.9.0",
    "firebase": "^12.15.0",
    "nuxt": "^4.5.1",
    "nuxt-vuefire": "^1.1.2",
    "typescript": "^5.6.3",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vue-tsc": "^2.1.10",
    "vuefire": "^3.2.3"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "esbuild",
      "protobufjs",
      "vue-demi"
    ]
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.1",
    "@tiptap/extension-youtube": "3.28.0"
  }
}
