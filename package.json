{
  "name": "memi-board",
  "version": "0.3.1",
  "type": "module",
  "description": "Firebase 기반 게시판 Vue 컴포넌트/composable 패키지 — Nuxt 4 + Nuxt UI 프로젝트에 posts CRUD, 첨부파일, 댓글, 권한, AI 검열을 바로 붙임",
  "license": "MIT",
  "author": "fkkmemi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fkkmemi/memi-board.git"
  },
  "bugs": {
    "url": "https://github.com/fkkmemi/memi-board/issues"
  },
  "homepage": "https://github.com/fkkmemi/memi-board#readme",
  "keywords": ["vue", "nuxt", "firebase", "firestore", "board", "community", "nuxt-ui"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "pnpm build",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxi prepare playground",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.0.0",
    "firebase": "^12.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.0.0 || ^5.0.0",
    "vuefire": "^3.2.3"
  },
  "devDependencies": {
    "@nuxt/ui": "^4.9.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "firebase": "^12.15.0",
    "nuxt": "^4.5.1",
    "nuxt-vuefire": "^1.1.2",
    "typescript": "^5.6.3",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vue-tsc": "^2.1.10",
    "vuefire": "^3.2.3"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "esbuild",
      "protobufjs",
      "vue-demi"
    ]
  }
}
