{
  "name": "memi-board",
  "version": "0.3.0",
  "type": "module",
  "description": "호스트 Firebase를 재사용하는 Vue 게시판 컴포넌트 패키지",
  "license": "MIT",
  "keywords": ["vue", "firebase", "firestore", "board", "community"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fkkmemi/memi-board.git"
  },
  "homepage": "https://github.com/fkkmemi/memi-board#readme",
  "bugs": {
    "url": "https://github.com/fkkmemi/memi-board/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/memi-board.js"
    }
  },
  "main": "./dist/memi-board.js",
  "module": "./dist/memi-board.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "prepack": "pnpm run typecheck && pnpm run build"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.0.0",
    "firebase": "^12.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "vuefire": "^3.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@nuxt/ui": "^4.9.0",
    "firebase": "^12.15.0",
    "typescript": "^5.6.3",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vue": "^3.5.40",
    "vue-router": "^4.5.0",
    "vue-tsc": "^3.0.0",
    "vuefire": "^3.2.3"
  },
  "packageManager": "pnpm@11.8.0"
}
