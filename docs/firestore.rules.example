// memi-board 0.23+ Firestore Rules (flat schema)
//
// memiBoardUsers/{uid}
// memiBoardSettings/{boardId}          (구 memiBoards/{id} stub + settings/config 통합)
// memiBoardPosts/{postId}(+ body/main)  boardId 필드로 보드 스코핑
// memiBoardComments/{commentId}         postId + boardId 필드로 스코핑
// memiBoardLikes/{likeId}               문서ID = `${postId}_${uid}` 또는 `${commentId}_${uid}`
//
// 카테고리 없음 — boardId 가 곧 예전 category id.
// posts/comments/likes 는 모두 최상위 flat 컬렉션이다. boardId(및 postId)가 이제
// 경로가 아니라 문서 필드이므로, list/collectionGroup 쿼리에 대한 권한 검사가
// 아래처럼 "쿼리의 등호(==) 필터가 그 필드를 상수로 고정해 주는가"에 의존한다.
// (구버전의 collectionGroup carve-out은 더 이상 필요 없음 — memiBoardPosts가
// 진짜 flat 컬렉션이라 작성자 교차조회도 일반 list 쿼리로 동작한다.)

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    // 호스트가 다른 기능(예: 손님 대기열)에서 익명 로그인을 켜둔 경우에도
    // 게시판 콘텐츠 생성(글/댓글/좋아요)만은 기본적으로 막는다 — 읽기·isSignedIn()
    // 전반은 그대로 두고, 아래 3개 create 규칙에서만 이 함수를 쓴다.
    function isBoardWriter() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function boardUserPath() {
      return /databases/$(database)/documents/memiBoardUsers/$(request.auth.uid);
    }
    function isBoardAdmin() {
      return isSignedIn()
        && exists(boardUserPath())
        && get(boardUserPath()).data.role == 'admin';
    }
    function isBoardStaff() {
      return isSignedIn()
        && exists(boardUserPath())
        && get(boardUserPath()).data.role in ['admin', 'staff'];
    }
    function boardSettingsPath(boardId) {
      return /databases/$(database)/documents/memiBoardSettings/$(boardId);
    }
    function postPath(postId) {
      return /databases/$(database)/documents/memiBoardPosts/$(postId);
    }
    function commentPath(commentId) {
      return /databases/$(database)/documents/memiBoardComments/$(commentId);
    }
    function isValidPostLike(likeId) {
      return request.resource.data.keys().hasOnly(['uid', 'postId', 'boardId', 'createdAt'])
        && likeId == request.resource.data.postId + '_' + request.auth.uid;
    }
    function isValidCommentLike(likeId) {
      // 예전 댓글은 boardId 가 없을 수 있다. 스푸핑 방지는 댓글의 postId + 부모 글 boardId 로 한다.
      return request.resource.data.keys().hasOnly(['uid', 'postId', 'boardId', 'createdAt', 'commentId', 'target'])
        && request.resource.data.target == 'comment'
        && request.resource.data.commentId is string
        && likeId == request.resource.data.commentId + '_' + request.auth.uid
        && exists(commentPath(request.resource.data.commentId))
        && get(commentPath(request.resource.data.commentId)).data.postId == request.resource.data.postId
        && get(postPath(request.resource.data.postId)).data.boardId == request.resource.data.boardId;
    }
    function isAllowedStaffForBoard(boardId) {
      let allowed = get(boardSettingsPath(boardId)).data.get('allowedStaffUids', []);
      return isBoardAdmin() || request.auth.uid in allowed;
    }
    function isBoardManager(boardId) {
      return isBoardStaff() && isAllowedStaffForBoard(boardId);
    }
    function canWriteBoard(boardId) {
      let requiredRole = get(boardSettingsPath(boardId)).data.get('writeRole', 'user');
      return exists(boardSettingsPath(boardId))
        && (requiredRole == 'user'
          || (requiredRole == 'staff' && isBoardStaff() && isAllowedStaffForBoard(boardId))
          || (requiredRole == 'admin' && isBoardAdmin()));
    }
    function canWriteBoardComment(boardId) {
      let hidden = get(boardSettingsPath(boardId)).data.get('visibility', 'public') == 'hidden';
      let requiredRole = get(boardSettingsPath(boardId)).data.get('commentWriteRole', 'user');
      return exists(boardSettingsPath(boardId))
        && (hidden
          ? isBoardManager(boardId)
          : (requiredRole == 'user'
            || (requiredRole == 'staff' && isBoardManager(boardId))
            || (requiredRole == 'admin' && isBoardAdmin())));
    }
    function isOwner(resource) {
      return isSignedIn() && request.auth.uid == resource.data.authorUid;
    }
    function isCommentCountUpdate() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
        && request.resource.data.commentCount is int
        && request.resource.data.commentCount >= 0
        && (request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
          || request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1);
    }
    function isLikeCountUpdate() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        && request.resource.data.likeCount is int
        && request.resource.data.likeCount >= 0
        && (request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1
          || request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1);
    }
    function isViewCountUpdate() {
      return resource.data.get('listed', true) == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
        && request.resource.data.viewCount is int
        && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1;
    }
    // 답글 생성/삭제 batch에서는 대상이 최상위(root) 댓글이라 작성자가 아닌 사람도
    // replyCount만 ±1 갱신할 수 있어야 한다 — 아니면 답글 작성 자체가 배치 전체로 막힌다.
    function isReplyCountUpdate() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
        && request.resource.data.replyCount is int
        && request.resource.data.replyCount >= 0
        && (request.resource.data.replyCount == resource.data.get('replyCount', 0) + 1
          || request.resource.data.replyCount == resource.data.get('replyCount', 0) - 1);
    }
    // 프로필 이름 변경 시 나를 답글 대상으로 가리키는 다른 사용자의 댓글에
    // 복제된 replyToName만 동기화할 수 있다. 작성자/본문 등 다른 필드는 불변이다.
    function isReplyTargetProfileUpdate() {
      return isSignedIn()
        && resource.data.replyToUid == request.auth.uid
        && request.resource.data.replyToUid == resource.data.replyToUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyToName']);
    }
    // data.boardId 는 이제 문서 필드다. list 쿼리에서 이 함수가 안전하게 평가되려면:
    //  - isBoardAdmin()/isBoardStaff() 만으로 true 가 되는 경우는 항상 OK
    //    (request.auth.uid 기준 get() 이라 문서 내용과 무관하게 항상 평가 가능)
    //  - (isBoardStaff() && canWriteBoard(data.boardId)) 분기에 기대려면 쿼리에
    //    where('boardId','==', b) 동등 필터가 있어야 한다 — 그래야 Firestore가
    //    potential result set 전체에 대해 data.boardId == b 임을 정적으로 증명하고
    //    get(boardSettingsPath(b))를 상수 조회로 안전하게 실행할 수 있다.
    function canReadPost(data) {
      return (data.get('listed', true) == true && data.isPublished == true)
        || (isSignedIn() && request.auth.uid == data.authorUid)
        || isBoardAdmin()
        || isBoardManager(data.boardId);
    }
    // 공개 피드·작성자 댓글 목록은 listed==true 동등 필터로 숨김 보드 댓글을 뺀다.
    // 글 상세(postId == 상수)에서는 부모 글을 읽을 수 있으면 숨김 댓글도 볼 수 있다
    // (작성자가 담당 스태프 메모를 읽는 경우).
    function canReadComment(data) {
      return data.get('listed', true) == true
        || (isSignedIn() && request.auth.uid == data.authorUid)
        || isBoardAdmin()
        || isBoardManager(data.boardId)
        || (data.postId is string
          && exists(postPath(data.postId))
          && canReadPost(get(postPath(data.postId)).data));
    }
    function expectedListed(boardId) {
      return get(boardSettingsPath(boardId)).data.get('visibility', 'public') != 'hidden';
    }

    match /memiBoardUsers/{uid} {
      // 이메일 말고는 다 공개 프로필 정보다 — 이메일은 private 서브컬렉션에 따로 둔다.
      allow read: if true;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'user'
        && (!('moderationBlockCount' in request.resource.data)
            || request.resource.data.moderationBlockCount == 0
            || request.resource.data.moderationBlockCount == 1);
      allow update: if (isBoardAdmin() && request.resource.data.role in ['admin', 'staff', 'user'])
        || (isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && (
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['moderationBlockCount', 'moderationBlockAt', 'aiWritingCount', 'aiWritingWindowAt'])
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['moderationBlockCount', 'moderationBlockAt', 'updatedAt'])
              && request.resource.data.moderationBlockCount
                == resource.data.get('moderationBlockCount', 0) + 1
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['aiWritingCount', 'aiWritingWindowAt', 'updatedAt'])
              && request.resource.data.aiWritingCount <= 10
              && (
                (
                  'aiWritingWindowAt' in resource.data
                  && request.time < resource.data.aiWritingWindowAt + duration.value(24, 'h')
                  && request.resource.data.aiWritingWindowAt == resource.data.aiWritingWindowAt
                  && request.resource.data.aiWritingCount
                    == resource.data.get('aiWritingCount', 0) + 1
                )
                || (
                  (!('aiWritingWindowAt' in resource.data)
                    || request.time >= resource.data.aiWritingWindowAt + duration.value(24, 'h'))
                  && request.resource.data.aiWritingWindowAt == request.time
                  && request.resource.data.aiWritingCount == 1
                )
              )
            )
          ));

      // 다른 작성자에 대해 나만 보는 개인 메모. 문서 ID가 targetUid라 대상당 하나로
      // 고정된다. 관리자도 못 읽는다 — 모더레이션용이 아니라 순전히 본인 참고용이다.
      match /memos/{targetUid} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      // 이메일만 담는 비공개 서브컬렉션. 본인·관리자만 읽고 쓴다.
      match /private/{docId} {
        allow read, write: if isBoardAdmin() || (isSignedIn() && request.auth.uid == uid);
      }
    }

    // 구 memiBoards/{boardId} stub + memiBoards/{boardId}/settings/config 를 하나로 합친
    // 캐노니컬 보드 문서. 목록 렌더링과 권한 검사가 모두 이 문서 하나만 읽는다.
    // create/update 를 분리한 이유: update 쪽 staff 분기가 resource.data(기존 값)를
    // 참조하는데, create 시점엔 resource 가 없어 하나로 묶으면 그 분기가 에러로
    // 평가된다 — 구버전에서도 보드 생성 자체는 admin 전용이었으므로 분리가 자연스럽다.
    match /memiBoardSettings/{boardId} {
      allow read: if true;
      allow create: if isBoardAdmin();
      allow update: if isBoardAdmin()
        || (isBoardManager(boardId)
          && request.resource.data.get('visibility', 'public')
            == resource.data.get('visibility', 'public')
          && request.resource.data.get('allowedStaffUids', [])
            == resource.data.get('allowedStaffUids', []));
      allow delete: if isBoardAdmin();
    }

    match /memiBoardPosts/{postId} {
      allow read: if canReadPost(resource.data);

      allow create: if isBoardWriter()
        && request.resource.data.boardId is string
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.moderationStatus == 'approved'
        && canWriteBoard(request.resource.data.boardId)
        && request.resource.data.listed is bool
        && request.resource.data.listed == expectedListed(request.resource.data.boardId)
        && request.resource.data.isPublished == false;

      allow update: if isOwner(resource) || isBoardManager(resource.data.boardId)
        || isCommentCountUpdate() || isLikeCountUpdate() || isViewCountUpdate();
      allow delete: if isOwner(resource) || isBoardManager(resource.data.boardId);

      match /body/{docId} {
        allow read: if canReadPost(get(postPath(postId)).data);
        allow write: if isOwner(get(postPath(postId)))
          || isBoardManager(get(postPath(postId)).data.boardId);
      }
    }

    match /memiBoardComments/{commentId} {
      // 공개 피드·작성자 댓글 목록은 where('listed','==',true) 로 숨김 보드 댓글을 걸러낸다.
      // 글 상세는 postId 동등 필터라 부모 글 권한(canReadPost)으로 숨김 댓글도 읽을 수 있다.
      allow read: if canReadComment(resource.data);

      allow create: if isBoardWriter()
        && request.resource.data.postId is string
        && request.resource.data.boardId is string
        // boardId 는 클라이언트가 채우는 비정규화 필드라 스푸핑이 가능하다 — 실제
        // 글의 boardId 와 다른 값을 채워 commentWriteRole 이 느슨한 다른 보드인 척
        // canWriteBoardComment() 를 우회하는 것을 막기 위해 부모 글의 실제 boardId 와
        // 일치하는지 확인한다(비용: 댓글 생성마다 get() 1회 추가).
        && get(postPath(request.resource.data.postId)).data.boardId == request.resource.data.boardId
        && canWriteBoardComment(request.resource.data.boardId)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1000
        && request.resource.data.moderationStatus == 'approved'
        && request.resource.data.listed is bool
        && request.resource.data.listed == expectedListed(request.resource.data.boardId);

      allow delete: if isOwner(resource)
        || isOwner(get(postPath(resource.data.postId)))
        || isBoardManager(resource.data.boardId);
      allow update: if isReplyCountUpdate() || isReplyTargetProfileUpdate()
        || isLikeCountUpdate()
        || (
          (isOwner(resource) || isBoardManager(resource.data.boardId))
          && request.resource.data.postId == resource.data.postId
          && request.resource.data.boardId == resource.data.boardId
          && request.resource.data.authorUid == resource.data.authorUid
          && (
            request.resource.data.get('listed', true) == resource.data.get('listed', true)
            || isBoardManager(resource.data.boardId)
          )
        );
    }

    // 좋아요 토글 전용 flat 컬렉션. 문서ID 관례 = `${targetId}_{uid}`.
    // 본문: target 없음(레거시) + 필드 4개. 댓글: target=='comment' + commentId.
    match /memiBoardLikes/{likeId} {
      // "내가 좋아요한 글/댓글" 쿼리(where uid==auth.uid)를 위해 자기 것은 항상 읽을 수
      // 있다. 그 외에는 구버전과 동일하게, 해당 글을 읽을 수 있는 사람이면 (uid를
      // 정확히 알고 있는 한) 개별 get() 으로 좋아요 여부를 확인할 수 있다.
      // resource == null: 아직 없는 좋아요 문서를 트랜잭션에서 get 할 때.
      // 없으면 resource.data 접근이 실패해 일반 사용자의 첫 좋아요가 permission-denied 가 된다.
      allow read: if (isSignedIn() && resource == null)
        || (isSignedIn() && request.auth.uid == resource.data.uid)
        || (resource != null && canReadPost(get(postPath(resource.data.postId)).data));

      allow create: if isBoardWriter()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.boardId is string
        && (isValidPostLike(likeId) || isValidCommentLike(likeId));

      allow delete: if isSignedIn() && request.auth.uid == resource.data.uid;
      // update 는 허용하지 않음 — 토글은 항상 create-or-delete.
    }

    // 글 신고. 문서ID = `${postId}_{uid}`. 내용은 본인·스태프만 읽는다.
    match /memiBoardReports/{reportId} {
      allow read: if (isSignedIn() && resource == null)
        || (isSignedIn() && request.auth.uid == resource.data.uid)
        || isBoardStaff();

      allow create: if isBoardWriter()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'target', 'postId', 'boardId', 'reason', 'detail', 'status',
          'createdAt', 'postTitle', 'authorUid', 'authorName'
        ])
        && request.resource.data.target == 'post'
        && request.resource.data.status == 'open'
        && request.resource.data.postId is string
        && request.resource.data.boardId is string
        && request.resource.data.reason in ['spam', 'abuse', 'adult', 'illegal', 'other']
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 200
        && request.resource.data.postTitle is string
        && request.resource.data.postTitle.size() <= 200
        && request.resource.data.authorUid is string
        && (request.resource.data.authorName == null || request.resource.data.authorName is string)
        && reportId == request.resource.data.postId + '_' + request.auth.uid
        && exists(postPath(request.resource.data.postId))
        && get(postPath(request.resource.data.postId)).data.boardId == request.resource.data.boardId
        && get(postPath(request.resource.data.postId)).data.authorUid != request.auth.uid;

      allow update: if isBoardManager(resource.data.boardId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedAt', 'reviewedBy'])
        && resource.data.status == 'open'
        && request.resource.data.status in ['dismissed', 'actioned']
        && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if false;
    }
  }
}
