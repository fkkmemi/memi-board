// memi-board 0.23+ Firestore Rules (flat schema)
//
// memiBoardUsers/{uid}
// memiBoardSettings/{boardId}          (merges the old memiBoards/{id} stub + settings/config)
// memiBoardPosts/{postId}(+ body/main)  scoped to a board by the boardId field
// memiBoardComments/{commentId}         scoped by the postId + boardId fields
// memiBoardLikes/{likeId}               doc ID = `${postId}_${uid}` or `${commentId}_${uid}`
//
// No categories — boardId is the old category id.
// posts/comments/likes are all top-level flat collections. Since boardId (and postId) are now
// document fields rather than paths, permission checks on list/collectionGroup queries
// depend, as below, on "whether the query's equality (==) filter pins that field to a constant".
// (The old collectionGroup carve-out is no longer needed — memiBoardPosts is
// a true flat collection, so cross-author lookups also work as regular list queries.)

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      // A server-only deletion marker also blocks still-valid cached ID tokens.
      return request.auth != null
        && (!exists(boardUserPath())
          || get(boardUserPath()).data.get('deletionPending', false) == false);
    }
    // Even if the host app enables anonymous sign-in for another feature (e.g. a guest queue),
    // block creating board content (posts/comments/likes) by default — reads and isSignedIn()
    // in general are left as-is; this function is used only in the 3 create rules below.
    function isBoardWriter() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function replyTargetIsActive() {
      let uid = request.resource.data.get('replyToUid', null);
      return uid == null || uid == '' || (uid is string
        && (!exists(/databases/$(database)/documents/memiBoardUsers/$(uid))
          || get(/databases/$(database)/documents/memiBoardUsers/$(uid)).data.get('deletionPending', false) == false));
    }
    function boardUserPath() {
      return /databases/$(database)/documents/memiBoardUsers/$(request.auth.uid);
    }
    function isBoardAdmin() {
      return isSignedIn()
        && exists(boardUserPath())
        && get(boardUserPath()).data.role in ['owner', 'admin'];
    }
    // Users with accumulated AI moderation blocks (10 or more, decaying by one every 24 hours) cannot create
    // posts or comments. Same calculation as the app; keep 10 and 86400000.0 in sync with
    // memiBoard.moderation.blockBanThreshold and blockBanDecayMs.
    function notModerationBanned() {
      return !exists(boardUserPath()) || moderationBlocksBelowLimit(get(boardUserPath()).data);
    }
    function moderationBlocksBelowLimit(u) {
      return u.get('moderationBlockCount', 0) < 10
        || (u.get('moderationBlockAt', null) != null
          && u.get('moderationBlockCount', 0)
            - math.floor((request.time.toMillis() - u.moderationBlockAt.toMillis()) / 86400000.0) < 10);
    }
    function isBoardStaff() {
      return isSignedIn()
        && exists(boardUserPath())
        && get(boardUserPath()).data.role in ['owner', 'admin', 'manager', 'staff'];
    }
    function boardSettingsPath(boardId) {
      return /databases/$(database)/documents/memiBoardSettings/$(boardId);
    }
    function postPath(postId) {
      return /databases/$(database)/documents/memiBoardPosts/$(postId);
    }
    function commentPath(commentId) {
      return /databases/$(database)/documents/memiBoardComments/$(commentId);
    }
    // One comment image. A missing or empty list is also allowed. The path must be that comment's folder.
    // Host apps that renamed the posts collection must also update the memiBoardPosts prefix.
    function commentImageEntryValid(img, postId, commentId) {
      return img.keys().hasOnly(['name', 'url', 'path', 'size', 'type'])
        && img.name is string
        && img.name.size() > 0
        && img.name.size() <= 200
        && img.url is string
        && img.url.matches('https://.*')
        && img.url.size() <= 2000
        && img.path is string
        && img.path.matches('^memiBoardPosts/' + postId + '/comment-images/' + commentId + '/[^/]+$')
        && img.size is int
        && img.size > 0
        && img.size < 5 * 1024 * 1024
        && img.type is string
        && img.type.matches('image/.*');
    }
    function commentImagesValid(postId, commentId) {
      return !request.resource.data.keys().hasAny(['images'])
        || (
          request.resource.data.images is list
          && request.resource.data.images.size() <= 1
          && (
            request.resource.data.images.size() == 0
            || commentImageEntryValid(request.resource.data.images[0], postId, commentId)
          )
        );
    }
    function isValidPostLike(likeId) {
      return request.resource.data.keys().hasOnly(['uid', 'postId', 'boardId', 'createdAt'])
        && likeId == request.resource.data.postId + '_' + request.auth.uid;
    }
    function isValidCommentLike(likeId) {
      // Older comments may lack boardId. Spoofing is prevented via the comment's postId + the parent post's boardId.
      return request.resource.data.keys().hasOnly(['uid', 'postId', 'boardId', 'createdAt', 'commentId', 'target'])
        && request.resource.data.target == 'comment'
        && request.resource.data.commentId is string
        && likeId == request.resource.data.commentId + '_' + request.auth.uid
        && exists(commentPath(request.resource.data.commentId))
        && get(commentPath(request.resource.data.commentId)).data.postId == request.resource.data.postId
        && get(commentPath(request.resource.data.commentId)).data.get('deletionPending', false) == false
        && get(postPath(request.resource.data.postId)).data.boardId == request.resource.data.boardId
        && get(postPath(request.resource.data.postId)).data.get('deletionPending', false) == false;
    }
    function isAllowedStaffForBoard(boardId) {
      let allowed = get(boardSettingsPath(boardId)).data.get('allowedStaffUids', []);
      return isBoardAdmin() || request.auth.uid in allowed
        || request.auth.uid in get(boardSettingsPath(boardId)).data.get('allowedManagerUids', []);
    }
    function isBoardOwner() {
      return isSignedIn() && get(boardUserPath()).data.role == 'owner';
    }
    function canConfigureBoard(boardId) {
      return isBoardAdmin() || (isSignedIn()
        && get(boardUserPath()).data.role == 'manager'
        && request.auth.uid in get(boardSettingsPath(boardId)).data.get('allowedManagerUids', []));
    }
    function canChangeRole(uid) {
      return isSignedIn() && uid != request.auth.uid
        && request.resource.data.role in ['admin', 'manager', 'staff', 'user']
        && resource.data.role != 'owner'
        && (isBoardOwner() || (isBoardAdmin()
          && resource.data.role != 'admin' && request.resource.data.role != 'admin'));
    }
    function isBoardManager(boardId) {
      return isBoardStaff() && isAllowedStaffForBoard(boardId);
    }
    // A visibility transition freezes new content until every listed flag is synchronized.
    // Notices (pinned, pinnedAt) change only via manager-only updates — an author's regular edit cannot change them.
    function postPinUnchanged() {
      return request.resource.data.get('pinned', false) == resource.data.get('pinned', false)
        && request.resource.data.get('pinnedAt', null) == resource.data.get('pinnedAt', null);
    }
    function isValidPostPinUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned', 'pinnedAt'])
        && (
          (request.resource.data.get('pinned', false) == true
            && request.resource.data.pinnedAt == request.time
            && resource.data.isPublished == true)
          || (!('pinned' in request.resource.data) && !('pinnedAt' in request.resource.data))
        );
    }
    function boardWritesOpen(boardId) {
      return get(boardSettingsPath(boardId)).data.get('visibilityTransition', '') == '';
    }
    function canDeletePostData(postId) {
      let post = get(postPath(postId));
      return isOwner(post) || isBoardManager(post.data.boardId);
    }
    function canDeleteLike(data) {
      return canDeletePostData(data.postId)
        || (data.get('target', '') == 'comment'
          && isOwner(get(commentPath(data.commentId))));
    }
    function canWriteBoard(boardId) {
      let requiredRole = get(boardSettingsPath(boardId)).data.get('writeRole', 'user');
      return exists(boardSettingsPath(boardId))
        && (requiredRole == 'user'
          || (requiredRole == 'staff' && isBoardStaff() && isAllowedStaffForBoard(boardId))
          || (requiredRole == 'admin' && isBoardAdmin()));
    }
    function canWriteBoardComment(boardId) {
      let hidden = get(boardSettingsPath(boardId)).data.get('visibility', 'public') == 'hidden';
      let requiredRole = get(boardSettingsPath(boardId)).data.get('commentWriteRole', 'user');
      return exists(boardSettingsPath(boardId))
        && (hidden
          ? isBoardManager(boardId)
          : (requiredRole == 'user'
            || (requiredRole == 'staff' && isBoardManager(boardId))
            || (requiredRole == 'admin' && isBoardAdmin())));
    }
    function isOwner(resource) {
      return isSignedIn() && request.auth.uid == resource.data.authorUid;
    }
    function isCommentCountUpdate() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
        && request.resource.data.commentCount is int
        && request.resource.data.commentCount >= 0
        && (request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
          || request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1);
    }
    function isLikeCountUpdate() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        && request.resource.data.likeCount is int
        && request.resource.data.likeCount >= 0
        && (request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1
          || request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1);
    }
    function isViewCountUpdate() {
      return resource.data.get('listed', true) == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
        && request.resource.data.viewCount is int
        && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1;
    }
    // In a reply create/delete batch the target is a root comment, so users other than its author
    // must be able to update only replyCount by ±1 — otherwise the whole batch, and thus writing a reply, is blocked.
    function isReplyCountUpdate() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
        && request.resource.data.replyCount is int
        && request.resource.data.replyCount >= 0
        && (request.resource.data.replyCount == resource.data.get('replyCount', 0) + 1
          || request.resource.data.replyCount == resource.data.get('replyCount', 0) - 1);
    }
    // When a profile name changes, only the copied replyToName in other users' comments that
    // point to me as the reply target may be synced. Author, body, and other fields are immutable.
    function isReplyTargetProfileUpdate() {
      return isSignedIn()
        && resource.data.replyToUid == request.auth.uid
        && request.resource.data.replyToUid == resource.data.replyToUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyToName']);
    }
    // data.boardId is now a document field. For this function to evaluate safely in list queries:
    //  - cases where isBoardAdmin()/isBoardStaff() alone yields true are always OK
    //    (get() is keyed on request.auth.uid, so it can always be evaluated regardless of document contents)
    //  - relying on the (isBoardStaff() && canWriteBoard(data.boardId)) branch requires the query
    //    to have a where('boardId','==', b) equality filter — that lets Firestore
    //    statically prove data.boardId == b for the entire potential result set and
    //    safely run get(boardSettingsPath(b)) as a constant lookup.
    // Profile name 50 chars, bio 200 (PROFILE_NAME_MAX, PROFILE_BIO_MAX). Updates check these fields only
    // when they change, so documents with older, longer values can still be edited otherwise.
    function nameFitsLimit(value) {
      return value == null || (value is string && value.size() <= 50);
    }
    function profileTextValid(data) {
      return (!('displayName' in data) || nameFitsLimit(data.displayName))
        && (!('authorName' in data) || nameFitsLimit(data.authorName))
        && (!('replyToName' in data) || nameFitsLimit(data.replyToName))
        && (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 200));
    }
    function profileTextChangeOk() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['displayName', 'authorName', 'replyToName', 'bio'])
        || profileTextValid(request.resource.data);
    }
    // Post title 150 chars (POST_TITLE_MAX), translated titles 300 (POST_TITLE_TRANSLATION_MAX).
    // Updates check them only when the title or translations change.
    function postTitleValid(data) {
      let m = data.get('i18n', {});
      return data.title is string && data.title.size() <= 150
        && (m.size() == 0
          || m.get('ko', {}).get('title', '').size() <= 300
          && m.get('en', {}).get('title', '').size() <= 300
          && m.get('ja', {}).get('title', '').size() <= 300
          && m.get('de', {}).get('title', '').size() <= 300
          && m.get('fr', {}).get('title', '').size() <= 300
          && m.get('es', {}).get('title', '').size() <= 300
          && m.get('pt', {}).get('title', '').size() <= 300
          && m.get('zh', {}).get('title', '').size() <= 300
          && m.get('ar', {}).get('title', '').size() <= 300
          && m.get('id', {}).get('title', '').size() <= 300);
    }
    // 10 tags (POST_TAG_MAX) of 30 chars, 20 custom field values (CUSTOM_FIELD_MAX) of 200 chars. Rules evaluate at most
    // 1,000 expressions per request, so instead of one check per item each list is joined with newlines and matched
    // with a single regex. Values containing a newline are rejected; non-string items are held to the same
    // length in their text form.
    // Joins the items with newlines and checks every length with one regex. Splitting again must give the same
    // count, so a value that contains a newline (and would otherwise pass as two short items) is rejected.
    function joinedItemsFit(items, pattern) {
      let joined = items.join('\n');
      return joined.split('\n').size() == items.size() && joined.matches(pattern);
    }
    function postTagsValid(data) {
      let t = data.get('tags', []);
      return t.size() == 0 || (t.size() <= 10 && joinedItemsFit(t, '[^\n]{0,30}(\n[^\n]{0,30})*'));
    }
    function postExtendValid(data) {
      let m = data.get('extend', {});
      return m.size() == 0 || (m.size() <= 20 && joinedItemsFit(m.values(), '[^\n]{0,200}(\n[^\n]{0,200})*'));
    }
    // Attachment entries must point into this post's attachments folder. File size and type are decided by storage.rules.
    function attachmentEntryValid(a, postId) {
      return a.name.size() <= 200
        && a.url.size() <= 2000 && a.url.matches('https://.+')
        && a.path.matches('memiBoardPosts/' + postId + '/attachments/[^/]+');
    }
    function postAttachmentsValid(data, postId) {
      let a = data.get('attachments', []);
      return a is list && a.size() <= 5
        && (a.size() == 0 || (attachmentEntryValid(a[0], postId) && (a.size() == 1 || (attachmentEntryValid(a[1], postId)
          && (a.size() == 2 || (attachmentEntryValid(a[2], postId) && (a.size() == 3 || (attachmentEntryValid(a[3], postId)
          && (a.size() == 4 || attachmentEntryValid(a[4], postId))))))))));
    }
    // Post updates check only the fields that changed, computing the diff once.
    function postFieldsChangeOk(postId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let data = request.resource.data;
      return (!changed.hasAny(['authorName']) || profileTextValid(data))
        && (!changed.hasAny(['title', 'i18n']) || postTitleValid(data))
        && (!changed.hasAny(['tags']) || postTagsValid(data))
        && (!changed.hasAny(['attachments']) || postAttachmentsValid(data, postId))
        && (!changed.hasAny(['extend']) || postExtendValid(data));
    }
    function canReadPost(data) {
      return (data.get('listed', true) == true && data.isPublished == true)
        || (isSignedIn() && request.auth.uid == data.authorUid)
        || isBoardAdmin()
        || isBoardManager(data.boardId);
    }
    // Public feeds and author comment lists exclude hidden-board comments with a listed==true equality filter.
    // On a post detail (postId == constant), anyone who can read the parent post can also see hidden comments
    // (e.g. an author reading an assigned staff memo).
    function canReadComment(data) {
      return data.listed == true
        || (isSignedIn() && request.auth.uid == data.authorUid)
        || isBoardAdmin()
        || isBoardManager(data.boardId)
        || (data.postId is string
          && exists(postPath(data.postId))
          && canReadPost(get(postPath(data.postId)).data));
    }
    function expectedListed(boardId) {
      return get(boardSettingsPath(boardId)).data.get('visibility', 'public') != 'hidden';
    }

    match /memiBoardAccountDeletionJobs/{uid} {
      allow read, write: if false;
    }

    match /memiBoardUsers/{uid} {
      // Everything except email is public profile info — email is kept separately in a private subcollection.
      allow read: if true;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && profileTextValid(request.resource.data)
        && request.resource.data.role == 'user'
        && (!('moderationBlockCount' in request.resource.data)
            || request.resource.data.moderationBlockCount == 0
            || request.resource.data.moderationBlockCount == 1);
      // Admins can reset a user's AI usage: the six counter fields are removed and nothing else changes.
      allow update: if profileTextChangeOk() && isBoardAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['aiWritingCount', 'aiWritingPending', 'aiWritingWindowAt', 'aiImageCount', 'aiImagePending', 'aiImageWindowAt', 'updatedAt'])
        && !request.resource.data.keys()
          .hasAny(['aiWritingCount', 'aiWritingPending', 'aiWritingWindowAt', 'aiImageCount', 'aiImagePending', 'aiImageWindowAt']);
      // Admins can clear a user's content warnings: the two moderation fields are removed and nothing else changes.
      allow update: if profileTextChangeOk() && isBoardAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['moderationBlockCount', 'moderationBlockAt', 'updatedAt'])
        && !request.resource.data.keys()
          .hasAny(['moderationBlockCount', 'moderationBlockAt']);
      allow update: if profileTextChangeOk() && ((canChangeRole(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt']))
        || (isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && (
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['moderationBlockCount', 'moderationBlockAt', 'aiWritingCount', 'aiWritingPending', 'aiWritingWindowAt',
                'aiImageCount', 'aiImagePending', 'aiImageWindowAt'])
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['moderationBlockCount', 'moderationBlockAt', 'updatedAt'])
              && request.resource.data.moderationBlockCount
                == resource.data.get('moderationBlockCount', 0) + 1
            )
            // 0.47.0 and earlier: increment the confirmed count by 1 before the call.
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['aiWritingCount', 'aiWritingWindowAt', 'updatedAt'])
              && request.resource.data.aiWritingCount <= 20
              && (
                (
                  'aiWritingWindowAt' in resource.data
                  && request.time < resource.data.aiWritingWindowAt + duration.value(24, 'h')
                  && request.resource.data.aiWritingWindowAt == resource.data.aiWritingWindowAt
                  && request.resource.data.aiWritingCount
                    == resource.data.get('aiWritingCount', 0) + 1
                )
                || (
                  (!('aiWritingWindowAt' in resource.data)
                    || request.time >= resource.data.aiWritingWindowAt + duration.value(24, 'h'))
                  && request.resource.data.aiWritingWindowAt == request.time
                  && request.resource.data.aiWritingCount == 1
                )
              )
            )
            // 0.47.1+: only reserve before the call, and confirm on success. On failure, only release the reservation.
            // The confirmed count only increases by 1 at a time and cannot be decreased by the client.
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['aiWritingPending', 'updatedAt'])
              && 'aiWritingWindowAt' in resource.data
              && request.time < resource.data.aiWritingWindowAt + duration.value(24, 'h')
              && (
                (
                  request.resource.data.aiWritingPending == resource.data.get('aiWritingPending', 0) + 1
                  && resource.data.get('aiWritingCount', 0) + request.resource.data.aiWritingPending <= 20
                )
                || (
                  resource.data.get('aiWritingPending', 0) >= 1
                  && request.resource.data.aiWritingPending == resource.data.get('aiWritingPending', 0) - 1
                )
              )
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['aiWritingCount', 'aiWritingPending', 'updatedAt'])
              && 'aiWritingWindowAt' in resource.data
              && request.time < resource.data.aiWritingWindowAt + duration.value(24, 'h')
              && resource.data.get('aiWritingPending', 0) >= 1
              && request.resource.data.aiWritingPending == resource.data.get('aiWritingPending', 0) - 1
              && request.resource.data.aiWritingCount == resource.data.get('aiWritingCount', 0) + 1
              && request.resource.data.aiWritingCount <= 20
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['aiWritingCount', 'aiWritingPending', 'aiWritingWindowAt', 'updatedAt'])
              && (!('aiWritingWindowAt' in resource.data)
                || request.time >= resource.data.aiWritingWindowAt + duration.value(24, 'h'))
              && request.resource.data.aiWritingWindowAt == request.time
              && request.resource.data.aiWritingCount == 0
              && request.resource.data.aiWritingPending == 1
            )
            // AI images are counted apart from writing (limit 3 per 24 h). Same reserve, confirm, release steps.
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['aiImagePending', 'updatedAt'])
              && 'aiImageWindowAt' in resource.data
              && request.time < resource.data.aiImageWindowAt + duration.value(24, 'h')
              && (
                (
                  request.resource.data.aiImagePending == resource.data.get('aiImagePending', 0) + 1
                  && resource.data.get('aiImageCount', 0) + request.resource.data.aiImagePending <= 3
                )
                || (
                  resource.data.get('aiImagePending', 0) >= 1
                  && request.resource.data.aiImagePending == resource.data.get('aiImagePending', 0) - 1
                )
              )
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['aiImageCount', 'aiImagePending', 'updatedAt'])
              && 'aiImageWindowAt' in resource.data
              && request.time < resource.data.aiImageWindowAt + duration.value(24, 'h')
              && resource.data.get('aiImagePending', 0) >= 1
              && request.resource.data.aiImagePending == resource.data.get('aiImagePending', 0) - 1
              && request.resource.data.aiImageCount == resource.data.get('aiImageCount', 0) + 1
              && request.resource.data.aiImageCount <= 3
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['aiImageCount', 'aiImagePending', 'aiImageWindowAt', 'updatedAt'])
              && (!('aiImageWindowAt' in resource.data)
                || request.time >= resource.data.aiImageWindowAt + duration.value(24, 'h'))
              && request.resource.data.aiImageWindowAt == request.time
              && request.resource.data.aiImageCount == 0
              && request.resource.data.aiImagePending == 1
            )
          )));

      // A private memo about another author, visible only to me. The doc ID is targetUid, so there is
      // one per target. Even admins can't read it — it is purely for personal reference, not moderation.
      match /memos/{targetUid} {
        allow read, delete: if isSignedIn() && request.auth.uid == uid;
        // Memo text up to 100 chars (AUTHOR_MEMO_MAX_LENGTH); sentiment is good, bad or none.
        allow create, update: if isSignedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['text', 'sentiment', 'updatedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 100
          && (request.resource.data.get('sentiment', null) == null
            || request.resource.data.sentiment in ['good', 'bad']);
      }

      // Private subcollection holding only the email. Only the user and admins can read and write.
      match /private/{docId} {
        allow read, write: if isBoardAdmin() || (isSignedIn() && request.auth.uid == uid);
      }
    }

    // Canonical board document that merges the old memiBoards/{boardId} stub + memiBoards/{boardId}/settings/config.
    // List rendering and permission checks both read only this one document.
    // Why create/update are separate: the staff branch on update references resource.data (existing values),
    // but resource doesn't exist at create time, so combining them would make that branch evaluate
    // to an error — board creation was admin-only in older versions too, so separating them is natural.
    match /memiBoardSettings/{boardId} {
      allow read: if true;
      allow create: if isBoardAdmin();
      allow update: if isBoardAdmin()
        || (canConfigureBoard(boardId)
          && request.resource.data.get('visibility', 'public')
            == resource.data.get('visibility', 'public')
          && request.resource.data.get('allowedManagerUids', [])
            == resource.data.get('allowedManagerUids', [])
          && request.resource.data.get('visibilityTransition', '')
            == resource.data.get('visibilityTransition', ''));
      allow delete: if isBoardAdmin();
    }

    // Older deployed clients still write auto-ID URLs. Freeze them only during backfill.
    function postSlugWritesOpen() {
      return !exists(/databases/$(database)/documents/memiBoardPostsSlugs/__migration)
        || get(/databases/$(database)/documents/memiBoardPostsSlugs/__migration).data.ready == true;
    }
    function validNewPostSlug(postId) {
      let data = request.resource.data;
      return data.slug is string && (
        data.slug == postId || data.slug.matches('.*-[a-zA-Z0-9]{20}')
        || getAfter(/databases/$(database)/documents/memiBoardPostsSlugs/$(data.boardId)/slugs/$(data.slug)).data.postId == postId
      );
    }

    // Address reservations contain only a post ID; private drafts never need to be queried.
    // Backfill every legacy slug before setting __migration.ready; keep reservations after deletion.
    match /memiBoardPostsSlugs/{boardId} {
      allow get: if isBoardWriter();
      allow list, write: if false;
      match /slugs/{slug} {
        allow get: if isBoardWriter() && canWriteBoard(boardId);
        allow list, update, delete: if false;
        // POST_SLUG_MAX(60) plus room for a numeric suffix.
        allow create: if isBoardWriter()
          && slug.size() <= 80
          && get(/databases/$(database)/documents/memiBoardPostsSlugs/__migration).data.ready == true
          && request.resource.data.keys().hasOnly(['postId'])
          && request.resource.data.postId is string
          && !exists(postPath(request.resource.data.postId))
          && getAfter(postPath(request.resource.data.postId)).data.boardId == boardId
          && getAfter(postPath(request.resource.data.postId)).data.slug == slug
          && getAfter(postPath(request.resource.data.postId)).data.authorUid == request.auth.uid;
      }
    }

    // Post edit history: memiBoardPosts/{postId}/revisions/{n}.
    // A content edit raises `revision` by one and, in the same commit, archives the state it overwrites
    // as revisions/{previous revision}. The revision rule checks the snapshot against the stored post and
    // body, and nobody can change or delete it afterwards.
    // Until memiBoardPostsSlugs/__migration has revisionsRequired == true, edits without a revision
    // are still accepted so host apps on packages before 0.62.0 keep working.
    function postRevisionPath(postId, revision) {
      return /databases/$(database)/documents/memiBoardPosts/$(postId)/revisions/$(string(revision));
    }
    function postBodyPath(postId) {
      return /databases/$(database)/documents/memiBoardPosts/$(postId)/body/main;
    }
    function revisionsRequired() {
      let marker = /databases/$(database)/documents/memiBoardPostsSlugs/__migration;
      return exists(marker) && get(marker).data.get('revisionsRequired', false) == true;
    }
    // Authors may edit a post up to 20 times (POST_EDIT_LIMIT). Board managers are not limited.
    function isValidPostRevisionBump(postId) {
      let before = resource.data.get('revision', 0);
      return request.resource.data.revision == before + 1
        && (request.resource.data.revision <= 20 || isBoardManager(resource.data.boardId))
        && request.resource.data.editedAt == request.time
        && existsAfter(postRevisionPath(postId, before));
    }
    function postRevisionOk(postId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isValidPostRevisionBump(postId)
        || (!changed.hasAny(['revision', 'editedAt'])
          && (!changed.hasAny(['title', 'tags', 'attachments', 'extend'])
            || (!revisionsRequired()
              && (resource.data.get('revision', 0) < 20 || isBoardManager(resource.data.boardId)))));
    }
    // Body content may change only together with a revision bump on the post.
    function bodyRevisionOk(postId) {
      return getAfter(postPath(postId)).data.get('revision', 0) == get(postPath(postId)).data.get('revision', 0) + 1
        || (!revisionsRequired()
          && (get(postPath(postId)).data.get('revision', 0) < 20
            || isBoardManager(get(postPath(postId)).data.boardId)));
    }
    function isValidPostRevision(postId, revisionId) {
      let post = get(postPath(postId)).data;
      let before = post.get('revision', 0);
      let data = request.resource.data;
      return data.keys().hasOnly([
          'boardId', 'revision', 'title', 'content', 'tags', 'attachments', 'extend',
          'authorUid', 'editedBy', 'editedByName', 'createdAt'
        ])
        && revisionId == string(before)
        && getAfter(postPath(postId)).data.get('revision', 0) == before + 1
        && data.revision == before
        && data.boardId == post.boardId
        && data.authorUid == post.authorUid
        && data.title == post.get('title', '')
        && data.tags == post.get('tags', [])
        && data.attachments == post.get('attachments', [])
        && data.get('extend', null) == post.get('extend', null)
        && data.content == (exists(postBodyPath(postId)) ? get(postBodyPath(postId)).data.get('content', '') : '')
        && data.editedBy == request.auth.uid
        && data.createdAt == request.time
        && (data.editedByName == null || (data.editedByName is string && data.editedByName.size() <= 80));
    }

    match /memiBoardPosts/{postId} {
      // Transactions check that a fresh attachment namespace has not already been saved.
      allow get: if isBoardWriter() && resource == null;
      allow read: if isBoardAdmin() || canReadPost(resource.data);

      allow create: if isBoardWriter()
        && notModerationBanned()
        && postSlugWritesOpen()
        && validNewPostSlug(postId)
        && request.resource.data.boardId is string
        && request.resource.data.authorUid == request.auth.uid
        && profileTextValid(request.resource.data)
        && postTitleValid(request.resource.data)
        && postTagsValid(request.resource.data)
        && postAttachmentsValid(request.resource.data, postId)
        && postExtendValid(request.resource.data)
        && request.resource.data.moderationStatus == 'approved'
        && canWriteBoard(request.resource.data.boardId)
        && boardWritesOpen(request.resource.data.boardId)
        && request.resource.data.listed is bool
        && request.resource.data.listed == expectedListed(request.resource.data.boardId)
        && request.resource.data.isPublished == false
        && !('pinned' in request.resource.data)
        && !('pinnedAt' in request.resource.data);

      allow update: if postFieldsChangeOk(postId) && (
        (
          (isOwner(resource) || isBoardManager(resource.data.boardId))
          && request.resource.data.get('slug', null) == resource.data.get('slug', null)
          && request.resource.data.boardId == resource.data.boardId
          && request.resource.data.authorUid == resource.data.authorUid
          && postRevisionOk(postId)
          && (
            (request.resource.data.listed == resource.data.listed
              && postPinUnchanged()
              && boardWritesOpen(resource.data.boardId))
            || (isBoardManager(resource.data.boardId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['listed']))
            || (isBoardManager(resource.data.boardId) && isValidPostPinUpdate())
          )
        ) || isCommentCountUpdate() || isLikeCountUpdate() || isViewCountUpdate());
      allow delete: if isOwner(resource) || isBoardManager(resource.data.boardId);

      match /body/{docId} {
        // Absolute body cap: 50,000 HTML chars (POST_BODY_MAX). The smaller limit that depends on the
        // number of translation languages is enforced by the app.
        function bodyContentFits() {
          return request.resource.data.get('content', '') is string
            && request.resource.data.get('content', '').size() <= 50000;
        }
        allow read: if isBoardAdmin() || canReadPost(get(postPath(postId)).data);
        // New posts create the body in the same transaction as the post.
        allow create: if (isOwner(getAfter(postPath(postId)))
            || isBoardManager(getAfter(postPath(postId)).data.boardId))
          && bodyContentFits()
          && (!exists(postPath(postId)) || bodyRevisionOk(postId));
        allow update: if (isOwner(getAfter(postPath(postId)))
            || isBoardManager(getAfter(postPath(postId)).data.boardId))
          && (request.resource.data.get('content', '') == resource.data.get('content', '')
            || (bodyContentFits() && bodyRevisionOk(postId)));
        // The body is deleted only together with its post, so content cannot be cleared without a revision.
        allow delete: if (isOwner(get(postPath(postId))) || isBoardManager(get(postPath(postId)).data.boardId))
          && (!existsAfter(postPath(postId)) || !revisionsRequired());
      }

      // Edit history. Readable by board managers and admins only. Kept when the post is deleted.
      // List queries must filter where('boardId', '==', boardId) so the manager check can be proven.
      match /revisions/{revisionId} {
        allow read: if isBoardAdmin() || isBoardManager(resource.data.boardId);
        allow create: if (isOwner(get(postPath(postId))) || isBoardManager(get(postPath(postId)).data.boardId))
          && isValidPostRevision(postId, revisionId);
        allow update, delete: if false;
      }
    }

    // Comment edit history: memiBoardComments/{commentId}/revisions/{n}. Same contract as posts:
    // a body or image edit raises `revision` by one and archives the replaced state in the same commit.
    function commentRevisionPath(commentId, revision) {
      return /databases/$(database)/documents/memiBoardComments/$(commentId)/revisions/$(string(revision));
    }
    // Authors may edit a comment up to 10 times (COMMENT_EDIT_LIMIT). Board managers are not limited.
    function commentRevisionOk(commentId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let before = resource.data.get('revision', 0);
      return (request.resource.data.get('revision', 0) == before + 1
          && (request.resource.data.get('revision', 0) <= 10 || isBoardManager(resource.data.boardId))
          && request.resource.data.editedAt == request.time
          && existsAfter(commentRevisionPath(commentId, before)))
        || (!changed.hasAny(['revision', 'editedAt'])
          && (!changed.hasAny(['body', 'images'])
            || (!revisionsRequired()
              && (resource.data.get('revision', 0) < 10 || isBoardManager(resource.data.boardId)))));
    }
    function isValidCommentRevision(commentId, revisionId) {
      let comment = get(commentPath(commentId)).data;
      let before = comment.get('revision', 0);
      let data = request.resource.data;
      return data.keys().hasOnly([
          'boardId', 'postId', 'revision', 'body', 'images',
          'authorUid', 'editedBy', 'editedByName', 'createdAt'
        ])
        && revisionId == string(before)
        && getAfter(commentPath(commentId)).data.get('revision', 0) == before + 1
        && data.revision == before
        && data.boardId == comment.boardId
        && data.postId == comment.postId
        && data.authorUid == comment.authorUid
        && data.body == comment.body
        && data.get('images', []) == comment.get('images', [])
        && data.editedBy == request.auth.uid
        && data.createdAt == request.time
        && (data.editedByName == null || (data.editedByName is string && data.editedByName.size() <= 80));
    }

    match /memiBoardComments/{commentId} {
      // Public feeds and author comment lists filter out hidden-board comments with where('listed','==',true).
      // Post details use a postId equality filter, so hidden comments can be read via parent post permission (canReadPost).
      allow read: if isBoardAdmin() || canReadComment(resource.data);

      allow create: if isBoardWriter()
        && notModerationBanned()
        && request.resource.data.postId is string
        && request.resource.data.boardId is string
        // boardId is a denormalized field filled by the client and can be spoofed — to prevent
        // filling in a value different from the post's actual boardId to pose as another board with a looser
        // commentWriteRole and bypass canWriteBoardComment(), check that it matches the parent post's actual
        // boardId (cost: one extra get() per comment creation).
        && get(postPath(request.resource.data.postId)).data.boardId == request.resource.data.boardId
        && get(postPath(request.resource.data.postId)).data.get('deletionPending', false) == false
        && (request.resource.data.get('parentId', null) == null
          || get(commentPath(request.resource.data.parentId)).data.get('deletionPending', false) == false)
        && replyTargetIsActive()
        && canWriteBoardComment(request.resource.data.boardId)
        && boardWritesOpen(request.resource.data.boardId)
        && request.resource.data.authorUid == request.auth.uid
        && profileTextValid(request.resource.data)
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1000
        && commentImagesValid(request.resource.data.postId, commentId)
        && !request.resource.data.keys().hasAny(['isBlinded', 'moderatedAt', 'moderatedBy'])
        && request.resource.data.moderationStatus == 'approved'
        && request.resource.data.listed is bool
        && request.resource.data.listed == expectedListed(request.resource.data.boardId);

      allow delete: if isBoardAdmin() || isOwner(resource)
        || isOwner(get(postPath(resource.data.postId)))
        || isBoardManager(resource.data.boardId);
      allow update: if profileTextChangeOk() && (isReplyCountUpdate() || isReplyTargetProfileUpdate()
        || isLikeCountUpdate()
        || (
          (isOwner(resource) || isBoardManager(resource.data.boardId))
          && request.resource.data.postId == resource.data.postId
          && request.resource.data.boardId == resource.data.boardId
          && request.resource.data.authorUid == resource.data.authorUid
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isBlinded', 'moderatedAt', 'moderatedBy'])
            || (isBoardManager(resource.data.boardId)
              && request.resource.data.isBlinded is bool
              && request.resource.data.moderatedBy == request.auth.uid
              && request.resource.data.moderatedAt == request.time))
          && commentImagesValid(request.resource.data.postId, commentId)
          && commentRevisionOk(commentId)
          && (
            request.resource.data.get('listed', true) == resource.data.get('listed', true)
            || isBoardManager(resource.data.boardId)
          )
        ));

      // Edit history. Readable by board managers and admins only. Kept when the comment is deleted.
      // List queries must filter where('boardId', '==', boardId) so the manager check can be proven.
      match /revisions/{revisionId} {
        allow read: if isBoardAdmin() || isBoardManager(resource.data.boardId);
        allow create: if (isOwner(get(commentPath(commentId)))
            || isBoardManager(get(commentPath(commentId)).data.boardId))
          && isValidCommentRevision(commentId, revisionId);
        allow update, delete: if false;
      }
    }

    // Flat collection for like toggles only. Doc ID convention = `${targetId}_{uid}`.
    // Body: no target (legacy) + 4 fields. Comments: target=='comment' + commentId.
    match /memiBoardLikes/{likeId} {
      // Your own likes are always readable for the "posts/comments I liked" query (where uid==auth.uid).
      // Otherwise, as in older versions, anyone who can read the post can check whether a like exists
      // via an individual get() (as long as they know the exact uid).
      // resource == null: when getting a like document that doesn't exist yet in a transaction.
      // Without this, accessing resource.data fails and a regular user's first like becomes permission-denied.
      allow read: if isBoardAdmin() || (isSignedIn() && resource == null)
        || (isSignedIn() && request.auth.uid == resource.data.uid)
        || (resource != null && canReadPost(get(postPath(resource.data.postId)).data))
        || (resource != null && resource.data.get('target', '') == 'comment'
          && canReadComment(get(commentPath(resource.data.commentId)).data));

      allow create: if isBoardWriter()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.boardId is string
        && get(postPath(request.resource.data.postId)).data.get('deletionPending', false) == false
        && (isValidPostLike(likeId) || isValidCommentLike(likeId));

      allow delete: if isBoardAdmin() || (isSignedIn()
        && (request.auth.uid == resource.data.uid || canDeleteLike(resource.data)));
      // update is not allowed — toggling is always create-or-delete.
    }

    // Post reports: doc ID = `${postId}_{uid}`.
    function isValidPostReport(reportId) {
      return request.resource.data.keys().hasOnly([
          'uid', 'target', 'postId', 'boardId', 'reason', 'detail', 'status',
          'createdAt', 'postTitle', 'authorUid', 'authorName'
        ])
        && request.resource.data.target == 'post'
        && reportId == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.authorUid == get(postPath(request.resource.data.postId)).data.authorUid;
    }
    // Comment reports: doc ID = `c_${commentId}_{uid}`. The excerpt keeps the reported text reviewable after deletion.
    function isValidCommentReport(reportId) {
      return request.resource.data.keys().hasOnly([
          'uid', 'target', 'postId', 'commentId', 'boardId', 'reason', 'detail', 'status',
          'createdAt', 'postTitle', 'commentExcerpt', 'authorUid', 'authorName'
        ])
        && request.resource.data.target == 'comment'
        && request.resource.data.commentId is string
        && request.resource.data.commentExcerpt is string
        && request.resource.data.commentExcerpt.size() <= 200
        && reportId == 'c_' + request.resource.data.commentId + '_' + request.auth.uid
        && exists(commentPath(request.resource.data.commentId))
        && get(commentPath(request.resource.data.commentId)).data.postId == request.resource.data.postId
        && get(commentPath(request.resource.data.commentId)).data.get('deletionPending', false) == false
        && request.resource.data.authorUid == get(commentPath(request.resource.data.commentId)).data.authorUid;
    }

    // Post and comment reports. Contents are readable only by the reporter and staff.
    match /memiBoardReports/{reportId} {
      allow read: if (isSignedIn() && resource == null)
        || (isSignedIn() && request.auth.uid == resource.data.uid)
        || isBoardAdmin() || isBoardManager(resource.data.boardId);

      allow create: if isBoardWriter()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.postId is string
        && request.resource.data.boardId is string
        && request.resource.data.reason in ['spam', 'abuse', 'adult', 'illegal', 'other']
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 200
        && (request.resource.data.reason != 'other'
          || request.resource.data.detail.matches('(?s).*\\S.*'))
        && request.resource.data.postTitle is string
        && request.resource.data.postTitle.size() <= 200
        && request.resource.data.authorUid is string
        && request.resource.data.authorUid != request.auth.uid
        && nameFitsLimit(request.resource.data.get('authorName', null))
        && exists(postPath(request.resource.data.postId))
        && get(postPath(request.resource.data.postId)).data.boardId == request.resource.data.boardId
        && get(postPath(request.resource.data.postId)).data.get('deletionPending', false) == false
        && (isValidPostReport(reportId) || isValidCommentReport(reportId));

      allow update: if isBoardManager(resource.data.boardId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedAt', 'reviewedBy', 'reviewedByName', 'reviewNote'])
        && resource.data.status == 'open'
        && request.resource.data.status in ['dismissed', 'actioned']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && (request.resource.data.get('reviewedByName', null) == null
          || (request.resource.data.reviewedByName is string && request.resource.data.reviewedByName.size() <= 80))
        && request.resource.data.get('reviewNote', '') is string
        && request.resource.data.get('reviewNote', '').size() <= 200
        && (!('reviewNote' in request.resource.data)
          || request.resource.data.reviewNote.matches('(?s).*\\S.*'));
      allow delete: if false;
    }
  }
}
