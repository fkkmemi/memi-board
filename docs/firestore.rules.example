// memi-board 0.23+ Firestore Rules (flat schema)
//
// memiBoardUsers/{uid}
// memiBoardSettings/{boardId}          (merges the old memiBoards/{id} stub + settings/config)
// memiBoardPosts/{postId}(+ body/main)  scoped to a board by the boardId field
// memiBoardComments/{commentId}         scoped by the postId + boardId fields
// memiBoardLikes/{likeId}               doc ID = `${postId}_${uid}` or `${commentId}_${uid}`
//
// No categories — boardId is the old category id.
// posts/comments/likes are all top-level flat collections. Since boardId (and postId) are now
// document fields rather than paths, permission checks on list/collectionGroup queries
// depend, as below, on "whether the query's equality (==) filter pins that field to a constant".
// (The old collectionGroup carve-out is no longer needed — memiBoardPosts is
// a true flat collection, so cross-author lookups also work as regular list queries.)

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    // Even if the host app enables anonymous sign-in for another feature (e.g. a guest queue),
    // block creating board content (posts/comments/likes) by default — reads and isSignedIn()
    // in general are left as-is; this function is used only in the 3 create rules below.
    function isBoardWriter() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function boardUserPath() {
      return /databases/$(database)/documents/memiBoardUsers/$(request.auth.uid);
    }
    function isBoardAdmin() {
      return isSignedIn()
        && exists(boardUserPath())
        && get(boardUserPath()).data.role in ['owner', 'admin'];
    }
    function isBoardStaff() {
      return isSignedIn()
        && exists(boardUserPath())
        && get(boardUserPath()).data.role in ['owner', 'admin', 'manager', 'staff'];
    }
    function boardSettingsPath(boardId) {
      return /databases/$(database)/documents/memiBoardSettings/$(boardId);
    }
    function postPath(postId) {
      return /databases/$(database)/documents/memiBoardPosts/$(postId);
    }
    function commentPath(commentId) {
      return /databases/$(database)/documents/memiBoardComments/$(commentId);
    }
    // One comment image. A missing or empty list is also allowed. The path must be that comment's folder.
    // Host apps that renamed the posts collection must also update the memiBoardPosts prefix.
    function commentImageEntryValid(img, postId, commentId) {
      return img.keys().hasOnly(['name', 'url', 'path', 'size', 'type'])
        && img.name is string
        && img.name.size() > 0
        && img.name.size() <= 200
        && img.url is string
        && img.url.matches('https://.*')
        && img.url.size() <= 2000
        && img.path is string
        && img.path.matches('^memiBoardPosts/' + postId + '/comment-images/' + commentId + '/[^/]+$')
        && img.size is int
        && img.size > 0
        && img.size < 5 * 1024 * 1024
        && img.type is string
        && img.type.matches('image/.*');
    }
    function commentImagesValid(postId, commentId) {
      return !request.resource.data.keys().hasAny(['images'])
        || (
          request.resource.data.images is list
          && request.resource.data.images.size() <= 1
          && (
            request.resource.data.images.size() == 0
            || commentImageEntryValid(request.resource.data.images[0], postId, commentId)
          )
        );
    }
    function isValidPostLike(likeId) {
      return request.resource.data.keys().hasOnly(['uid', 'postId', 'boardId', 'createdAt'])
        && likeId == request.resource.data.postId + '_' + request.auth.uid;
    }
    function isValidCommentLike(likeId) {
      // Older comments may lack boardId. Spoofing is prevented via the comment's postId + the parent post's boardId.
      return request.resource.data.keys().hasOnly(['uid', 'postId', 'boardId', 'createdAt', 'commentId', 'target'])
        && request.resource.data.target == 'comment'
        && request.resource.data.commentId is string
        && likeId == request.resource.data.commentId + '_' + request.auth.uid
        && exists(commentPath(request.resource.data.commentId))
        && get(commentPath(request.resource.data.commentId)).data.postId == request.resource.data.postId
        && get(postPath(request.resource.data.postId)).data.boardId == request.resource.data.boardId;
    }
    function isAllowedStaffForBoard(boardId) {
      let allowed = get(boardSettingsPath(boardId)).data.get('allowedStaffUids', []);
      return isBoardAdmin() || request.auth.uid in allowed
        || request.auth.uid in get(boardSettingsPath(boardId)).data.get('allowedManagerUids', []);
    }
    function isBoardOwner() {
      return isSignedIn() && get(boardUserPath()).data.role == 'owner';
    }
    function canConfigureBoard(boardId) {
      return isBoardAdmin() || (isSignedIn()
        && get(boardUserPath()).data.role == 'manager'
        && request.auth.uid in get(boardSettingsPath(boardId)).data.get('allowedManagerUids', []));
    }
    function canChangeRole(uid) {
      return isSignedIn() && uid != request.auth.uid
        && request.resource.data.role in ['admin', 'manager', 'staff', 'user']
        && resource.data.role != 'owner'
        && (isBoardOwner() || (isBoardAdmin()
          && resource.data.role != 'admin' && request.resource.data.role != 'admin'));
    }
    function isBoardManager(boardId) {
      return isBoardStaff() && isAllowedStaffForBoard(boardId);
    }
    // A visibility transition freezes new content until every listed flag is synchronized.
    // Notices (pinned, pinnedAt) change only via manager-only updates — an author's regular edit cannot change them.
    function postPinUnchanged() {
      return request.resource.data.get('pinned', false) == resource.data.get('pinned', false)
        && request.resource.data.get('pinnedAt', null) == resource.data.get('pinnedAt', null);
    }
    function isValidPostPinUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned', 'pinnedAt'])
        && (
          (request.resource.data.get('pinned', false) == true
            && request.resource.data.pinnedAt == request.time
            && resource.data.isPublished == true)
          || (!('pinned' in request.resource.data) && !('pinnedAt' in request.resource.data))
        );
    }
    function boardWritesOpen(boardId) {
      return get(boardSettingsPath(boardId)).data.get('visibilityTransition', '') == '';
    }
    function canDeletePostData(postId) {
      let post = get(postPath(postId));
      return isOwner(post) || isBoardManager(post.data.boardId);
    }
    function canDeleteLike(data) {
      return canDeletePostData(data.postId)
        || (data.get('target', '') == 'comment'
          && isOwner(get(commentPath(data.commentId))));
    }
    function canWriteBoard(boardId) {
      let requiredRole = get(boardSettingsPath(boardId)).data.get('writeRole', 'user');
      return exists(boardSettingsPath(boardId))
        && (requiredRole == 'user'
          || (requiredRole == 'staff' && isBoardStaff() && isAllowedStaffForBoard(boardId))
          || (requiredRole == 'admin' && isBoardAdmin()));
    }
    function canWriteBoardComment(boardId) {
      let hidden = get(boardSettingsPath(boardId)).data.get('visibility', 'public') == 'hidden';
      let requiredRole = get(boardSettingsPath(boardId)).data.get('commentWriteRole', 'user');
      return exists(boardSettingsPath(boardId))
        && (hidden
          ? isBoardManager(boardId)
          : (requiredRole == 'user'
            || (requiredRole == 'staff' && isBoardManager(boardId))
            || (requiredRole == 'admin' && isBoardAdmin())));
    }
    function isOwner(resource) {
      return isSignedIn() && request.auth.uid == resource.data.authorUid;
    }
    function isCommentCountUpdate() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
        && request.resource.data.commentCount is int
        && request.resource.data.commentCount >= 0
        && (request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
          || request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1);
    }
    function isLikeCountUpdate() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        && request.resource.data.likeCount is int
        && request.resource.data.likeCount >= 0
        && (request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1
          || request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1);
    }
    function isViewCountUpdate() {
      return resource.data.get('listed', true) == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
        && request.resource.data.viewCount is int
        && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1;
    }
    // In a reply create/delete batch the target is a root comment, so users other than its author
    // must be able to update only replyCount by ±1 — otherwise the whole batch, and thus writing a reply, is blocked.
    function isReplyCountUpdate() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
        && request.resource.data.replyCount is int
        && request.resource.data.replyCount >= 0
        && (request.resource.data.replyCount == resource.data.get('replyCount', 0) + 1
          || request.resource.data.replyCount == resource.data.get('replyCount', 0) - 1);
    }
    // When a profile name changes, only the copied replyToName in other users' comments that
    // point to me as the reply target may be synced. Author, body, and other fields are immutable.
    function isReplyTargetProfileUpdate() {
      return isSignedIn()
        && resource.data.replyToUid == request.auth.uid
        && request.resource.data.replyToUid == resource.data.replyToUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyToName']);
    }
    // data.boardId is now a document field. For this function to evaluate safely in list queries:
    //  - cases where isBoardAdmin()/isBoardStaff() alone yields true are always OK
    //    (get() is keyed on request.auth.uid, so it can always be evaluated regardless of document contents)
    //  - relying on the (isBoardStaff() && canWriteBoard(data.boardId)) branch requires the query
    //    to have a where('boardId','==', b) equality filter — that lets Firestore
    //    statically prove data.boardId == b for the entire potential result set and
    //    safely run get(boardSettingsPath(b)) as a constant lookup.
    function canReadPost(data) {
      return (data.get('listed', true) == true && data.isPublished == true)
        || (isSignedIn() && request.auth.uid == data.authorUid)
        || isBoardAdmin()
        || isBoardManager(data.boardId);
    }
    // Public feeds and author comment lists exclude hidden-board comments with a listed==true equality filter.
    // On a post detail (postId == constant), anyone who can read the parent post can also see hidden comments
    // (e.g. an author reading an assigned staff memo).
    function canReadComment(data) {
      return data.listed == true
        || (isSignedIn() && request.auth.uid == data.authorUid)
        || isBoardAdmin()
        || isBoardManager(data.boardId)
        || (data.postId is string
          && exists(postPath(data.postId))
          && canReadPost(get(postPath(data.postId)).data));
    }
    function expectedListed(boardId) {
      return get(boardSettingsPath(boardId)).data.get('visibility', 'public') != 'hidden';
    }

    match /memiBoardUsers/{uid} {
      // Everything except email is public profile info — email is kept separately in a private subcollection.
      allow read: if true;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'user'
        && (!('moderationBlockCount' in request.resource.data)
            || request.resource.data.moderationBlockCount == 0
            || request.resource.data.moderationBlockCount == 1);
      allow update: if (canChangeRole(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt']))
        || (isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && (
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['moderationBlockCount', 'moderationBlockAt', 'aiWritingCount', 'aiWritingPending', 'aiWritingWindowAt'])
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['moderationBlockCount', 'moderationBlockAt', 'updatedAt'])
              && request.resource.data.moderationBlockCount
                == resource.data.get('moderationBlockCount', 0) + 1
            )
            // 0.47.0 and earlier: increment the confirmed count by 1 before the call.
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['aiWritingCount', 'aiWritingWindowAt', 'updatedAt'])
              && request.resource.data.aiWritingCount <= 10
              && (
                (
                  'aiWritingWindowAt' in resource.data
                  && request.time < resource.data.aiWritingWindowAt + duration.value(24, 'h')
                  && request.resource.data.aiWritingWindowAt == resource.data.aiWritingWindowAt
                  && request.resource.data.aiWritingCount
                    == resource.data.get('aiWritingCount', 0) + 1
                )
                || (
                  (!('aiWritingWindowAt' in resource.data)
                    || request.time >= resource.data.aiWritingWindowAt + duration.value(24, 'h'))
                  && request.resource.data.aiWritingWindowAt == request.time
                  && request.resource.data.aiWritingCount == 1
                )
              )
            )
            // 0.47.1+: only reserve before the call, and confirm on success. On failure, only release the reservation.
            // The confirmed count only increases by 1 at a time and cannot be decreased by the client.
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['aiWritingPending', 'updatedAt'])
              && 'aiWritingWindowAt' in resource.data
              && request.time < resource.data.aiWritingWindowAt + duration.value(24, 'h')
              && (
                (
                  request.resource.data.aiWritingPending == resource.data.get('aiWritingPending', 0) + 1
                  && resource.data.get('aiWritingCount', 0) + request.resource.data.aiWritingPending <= 10
                )
                || (
                  resource.data.get('aiWritingPending', 0) >= 1
                  && request.resource.data.aiWritingPending == resource.data.get('aiWritingPending', 0) - 1
                )
              )
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['aiWritingCount', 'aiWritingPending', 'updatedAt'])
              && 'aiWritingWindowAt' in resource.data
              && request.time < resource.data.aiWritingWindowAt + duration.value(24, 'h')
              && resource.data.get('aiWritingPending', 0) >= 1
              && request.resource.data.aiWritingPending == resource.data.get('aiWritingPending', 0) - 1
              && request.resource.data.aiWritingCount == resource.data.get('aiWritingCount', 0) + 1
              && request.resource.data.aiWritingCount <= 10
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['aiWritingCount', 'aiWritingPending', 'aiWritingWindowAt', 'updatedAt'])
              && (!('aiWritingWindowAt' in resource.data)
                || request.time >= resource.data.aiWritingWindowAt + duration.value(24, 'h'))
              && request.resource.data.aiWritingWindowAt == request.time
              && request.resource.data.aiWritingCount == 0
              && request.resource.data.aiWritingPending == 1
            )
          ));

      // A private memo about another author, visible only to me. The doc ID is targetUid, so there is
      // one per target. Even admins can't read it — it is purely for personal reference, not moderation.
      match /memos/{targetUid} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      // Private subcollection holding only the email. Only the user and admins can read and write.
      match /private/{docId} {
        allow read, write: if isBoardAdmin() || (isSignedIn() && request.auth.uid == uid);
      }
    }

    // Canonical board document that merges the old memiBoards/{boardId} stub + memiBoards/{boardId}/settings/config.
    // List rendering and permission checks both read only this one document.
    // Why create/update are separate: the staff branch on update references resource.data (existing values),
    // but resource doesn't exist at create time, so combining them would make that branch evaluate
    // to an error — board creation was admin-only in older versions too, so separating them is natural.
    match /memiBoardSettings/{boardId} {
      allow read: if true;
      allow create: if isBoardAdmin();
      allow update: if isBoardAdmin()
        || (canConfigureBoard(boardId)
          && request.resource.data.get('visibility', 'public')
            == resource.data.get('visibility', 'public')
          && request.resource.data.get('allowedManagerUids', [])
            == resource.data.get('allowedManagerUids', [])
          && request.resource.data.get('visibilityTransition', '')
            == resource.data.get('visibilityTransition', ''));
      allow delete: if isBoardAdmin();
    }

    match /memiBoardPosts/{postId} {
      allow read: if isBoardAdmin() || canReadPost(resource.data);

      allow create: if isBoardWriter()
        && request.resource.data.boardId is string
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.moderationStatus == 'approved'
        && canWriteBoard(request.resource.data.boardId)
        && boardWritesOpen(request.resource.data.boardId)
        && request.resource.data.listed is bool
        && request.resource.data.listed == expectedListed(request.resource.data.boardId)
        && request.resource.data.isPublished == false
        && !('pinned' in request.resource.data)
        && !('pinnedAt' in request.resource.data);

      allow update: if (
          (isOwner(resource) || isBoardManager(resource.data.boardId))
          && request.resource.data.boardId == resource.data.boardId
          && request.resource.data.authorUid == resource.data.authorUid
          && (
            (request.resource.data.listed == resource.data.listed
              && postPinUnchanged()
              && boardWritesOpen(resource.data.boardId))
            || (isBoardManager(resource.data.boardId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['listed']))
            || (isBoardManager(resource.data.boardId) && isValidPostPinUpdate())
          )
        ) || isCommentCountUpdate() || isLikeCountUpdate() || isViewCountUpdate();
      allow delete: if isOwner(resource) || isBoardManager(resource.data.boardId);

      match /body/{docId} {
        allow read: if isBoardAdmin() || canReadPost(get(postPath(postId)).data);
        allow write: if isOwner(getAfter(postPath(postId)))
          || isBoardManager(getAfter(postPath(postId)).data.boardId);
      }
    }

    match /memiBoardComments/{commentId} {
      // Public feeds and author comment lists filter out hidden-board comments with where('listed','==',true).
      // Post details use a postId equality filter, so hidden comments can be read via parent post permission (canReadPost).
      allow read: if isBoardAdmin() || canReadComment(resource.data);

      allow create: if isBoardWriter()
        && request.resource.data.postId is string
        && request.resource.data.boardId is string
        // boardId is a denormalized field filled by the client and can be spoofed — to prevent
        // filling in a value different from the post's actual boardId to pose as another board with a looser
        // commentWriteRole and bypass canWriteBoardComment(), check that it matches the parent post's actual
        // boardId (cost: one extra get() per comment creation).
        && get(postPath(request.resource.data.postId)).data.boardId == request.resource.data.boardId
        && canWriteBoardComment(request.resource.data.boardId)
        && boardWritesOpen(request.resource.data.boardId)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1000
        && commentImagesValid(request.resource.data.postId, commentId)
        && request.resource.data.moderationStatus == 'approved'
        && request.resource.data.listed is bool
        && request.resource.data.listed == expectedListed(request.resource.data.boardId);

      allow delete: if isBoardAdmin() || isOwner(resource)
        || isOwner(get(postPath(resource.data.postId)))
        || isBoardManager(resource.data.boardId);
      allow update: if isReplyCountUpdate() || isReplyTargetProfileUpdate()
        || isLikeCountUpdate()
        || (
          (isOwner(resource) || isBoardManager(resource.data.boardId))
          && request.resource.data.postId == resource.data.postId
          && request.resource.data.boardId == resource.data.boardId
          && request.resource.data.authorUid == resource.data.authorUid
          && commentImagesValid(request.resource.data.postId, commentId)
          && (
            request.resource.data.get('listed', true) == resource.data.get('listed', true)
            || isBoardManager(resource.data.boardId)
          )
        );
    }

    // Flat collection for like toggles only. Doc ID convention = `${targetId}_{uid}`.
    // Body: no target (legacy) + 4 fields. Comments: target=='comment' + commentId.
    match /memiBoardLikes/{likeId} {
      // Your own likes are always readable for the "posts/comments I liked" query (where uid==auth.uid).
      // Otherwise, as in older versions, anyone who can read the post can check whether a like exists
      // via an individual get() (as long as they know the exact uid).
      // resource == null: when getting a like document that doesn't exist yet in a transaction.
      // Without this, accessing resource.data fails and a regular user's first like becomes permission-denied.
      allow read: if isBoardAdmin() || (isSignedIn() && resource == null)
        || (isSignedIn() && request.auth.uid == resource.data.uid)
        || (resource != null && canReadPost(get(postPath(resource.data.postId)).data))
        || (resource != null && resource.data.get('target', '') == 'comment'
          && canReadComment(get(commentPath(resource.data.commentId)).data));

      allow create: if isBoardWriter()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.boardId is string
        && (isValidPostLike(likeId) || isValidCommentLike(likeId));

      allow delete: if isBoardAdmin() || (isSignedIn()
        && (request.auth.uid == resource.data.uid || canDeleteLike(resource.data)));
      // update is not allowed — toggling is always create-or-delete.
    }

    // Post reports. Doc ID = `${postId}_{uid}`. Contents are readable only by the reporter and staff.
    match /memiBoardReports/{reportId} {
      allow read: if (isSignedIn() && resource == null)
        || (isSignedIn() && request.auth.uid == resource.data.uid)
        || isBoardAdmin() || isBoardManager(resource.data.boardId);

      allow create: if isBoardWriter()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'target', 'postId', 'boardId', 'reason', 'detail', 'status',
          'createdAt', 'postTitle', 'authorUid', 'authorName'
        ])
        && request.resource.data.target == 'post'
        && request.resource.data.status == 'open'
        && request.resource.data.postId is string
        && request.resource.data.boardId is string
        && request.resource.data.reason in ['spam', 'abuse', 'adult', 'illegal', 'other']
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 200
        && request.resource.data.postTitle is string
        && request.resource.data.postTitle.size() <= 200
        && request.resource.data.authorUid is string
        && (request.resource.data.authorName == null || request.resource.data.authorName is string)
        && reportId == request.resource.data.postId + '_' + request.auth.uid
        && exists(postPath(request.resource.data.postId))
        && get(postPath(request.resource.data.postId)).data.boardId == request.resource.data.boardId
        && get(postPath(request.resource.data.postId)).data.authorUid != request.auth.uid;

      allow update: if isBoardManager(resource.data.boardId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedAt', 'reviewedBy'])
        && resource.data.status == 'open'
        && request.resource.data.status in ['dismissed', 'actioned']
        && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if false;
    }
  }
}
