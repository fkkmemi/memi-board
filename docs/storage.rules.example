// memi-board 0.21+ Storage Rules
// memiBoards/{boardId}/posts/{postId}/attachments|images/...

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isBoardStaff() {
      let userPath = /databases/(default)/documents/memiBoardUsers/$(request.auth.uid);
      return isSignedIn()
        && firestore.exists(userPath)
        && firestore.get(userPath).data.role in ['admin', 'staff'];
    }
    function postExists(boardId, postId) {
      return firestore.exists(/databases/(default)/documents/memiBoards/$(boardId)/posts/$(postId));
    }
    function isPostOwner(boardId, postId) {
      let postPath = /databases/(default)/documents/memiBoards/$(boardId)/posts/$(postId);
      return isSignedIn()
        && firestore.exists(postPath)
        && firestore.get(postPath).data.authorUid == request.auth.uid;
    }

    match /memiBoards/{boardId}/posts/{postId}/attachments/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && (!postExists(boardId, postId) || isPostOwner(boardId, postId) || isBoardStaff())
        && request.resource.size < 20 * 1024 * 1024;
      allow delete: if isSignedIn()
        && (!postExists(boardId, postId) || isPostOwner(boardId, postId) || isBoardStaff());
    }

    match /memiBoards/{boardId}/posts/{postId}/images/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn()
        && (!postExists(boardId, postId) || isPostOwner(boardId, postId) || isBoardStaff())
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif|jpg|heic|heif)');
      allow delete: if isSignedIn()
        && (!postExists(boardId, postId) || isPostOwner(boardId, postId) || isBoardStaff());
    }
  }
}
