// memi-board 0.23+ Storage Rules (flat schema)
// memiBoardPosts/{postId}/attachments|images/...
// postId 가 전역 고유이므로 boardId prefix 는 더 이상 필요 없음.

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isBoardStaff() {
      let userPath = /databases/(default)/documents/memiBoardUsers/$(request.auth.uid);
      return isSignedIn()
        && firestore.exists(userPath)
        && firestore.get(userPath).data.role in ['admin', 'staff'];
    }
    function postExists(postId) {
      return firestore.exists(/databases/(default)/documents/memiBoardPosts/$(postId));
    }
    function isPostOwner(postId) {
      let postPath = /databases/(default)/documents/memiBoardPosts/$(postId);
      return isSignedIn()
        && firestore.exists(postPath)
        && firestore.get(postPath).data.authorUid == request.auth.uid;
    }

    match /memiBoardPosts/{postId}/attachments/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && (!postExists(postId) || isPostOwner(postId) || isBoardStaff())
        && request.resource.size < 20 * 1024 * 1024;
      allow delete: if isSignedIn()
        && (!postExists(postId) || isPostOwner(postId) || isBoardStaff());
    }

    match /memiBoardPosts/{postId}/images/{allPaths=**} {
      allow read: if true;
      // 글쓰기 화면은 Firestore 문서를 만들기 전에 Storage 경로(미리 딴 postId)로
      // 올린다. 붙여넣기 이미지는 image/png 등이 오고, firestore.exists()가
      // Storage 규칙에서 실패하면 조건 전체가 unauthorized 가 된다.
      // 쓰기는 로그인 + 용량 + image/* 만 본다. 삭제는 소유자/스태프.
      allow write: if isSignedIn()
        && request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn()
        && (!postExists(postId) || isPostOwner(postId) || isBoardStaff());
    }

    // 프로필 사진 — 경로가 uid로 고정돼 있어 본인만 쓸 수 있다. 공개 프로필의 일부라 읽기는 전체 공개.
    match /memiBoardUsers/{uid}/avatar.jpg {
      allow read: if true;
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg');
    }
  }
}
