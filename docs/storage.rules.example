// memi-board 0.45.1+ Storage Rules (flat schema, ownerUid metadata)
// memiBoardPosts/{postId}/attachments|images|comment-images/...
// postId is globally unique, so the boardId prefix is no longer needed.
// In the host app's Firebase project, the Storage service account must be granted
// the roles/firebaserules.firestoreServiceAgent role.
// Without firestore.exists/get read access, image/attachment uploads and file deletes fail as unauthorized.
// Setup and verification: the "Firestore read access for Storage rules" section of docs/firebase-setup.md.

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    // Storage permits at most two distinct Firestore document reads:
    // post + user role. Scoped staff must not gain global file access.
    function isBoardStaff() {
      let userPath = /databases/(default)/documents/memiBoardUsers/$(request.auth.uid);
      return isSignedIn() && firestore.exists(userPath)
        && firestore.get(userPath).data.role in ['owner', 'admin'];
    }
    function canWritePostFile(postId) {
      return isSignedIn() && (postExists(postId)
        ? (isPostOwner(postId) || isBoardStaff())
        : (request.resource.metadata.ownerUid == request.auth.uid
          && (resource == null || resource.metadata.ownerUid == request.auth.uid)));
    }
    function canDeletePostFile(postId) {
      return isSignedIn() && (isBoardStaff() || (postExists(postId)
        ? isPostOwner(postId)
        : resource.metadata.ownerUid == request.auth.uid));
    }
    function postExists(postId) {
      return firestore.exists(/databases/(default)/documents/memiBoardPosts/$(postId));
    }
    function isPostOwner(postId) {
      let postPath = /databases/(default)/documents/memiBoardPosts/$(postId);
      return isSignedIn()
        && firestore.exists(postPath)
        && firestore.get(postPath).data.authorUid == request.auth.uid;
    }

    // When a post is deleted, the package runs listAll on images/, attachments/, and comment-images/.
    // 0.38.0 and earlier use listAll on the parent path (memiBoardPosts/{postId}).
    // The request prefix is always memiBoardPosts/{postId}/ (with a trailing slash), so
    // match /memiBoardPosts/{postId} { allow list } alone results in a 403.
    // {allPaths=**} matches zero or more segments and is needed for folder listing and file get/delete.
    // Don't put write here — the size and image/* limits are handled by the more specific matches below.
    // Global admin maintenance lists the collection root to find abandoned uploads.
    match /memiBoardPosts/{allPaths=**} {
      allow list: if isBoardStaff();
    }

    match /memiBoardPosts/{postId}/{allPaths=**} {
      allow get: if true;
      allow list: if isBoardStaff() || isPostOwner(postId);
      allow delete: if canDeletePostFile(postId);
    }

    match /memiBoardPosts/{postId}/attachments/{fileName} {
      allow get: if true;
      allow create, update: if canWritePostFile(postId)
        && request.resource.size < 20 * 1024 * 1024;
      allow delete: if canDeletePostFile(postId);
    }

    match /memiBoardPosts/{postId}/images/{allPaths=**} {
      allow get: if true;
      // The editor uploads to the Storage path (using a pre-generated postId) before creating the
      // Firestore document. Pasted images arrive as image/png, etc.
      // Existing posts can be modified only by the author/staff. Files not yet saved are protected by ownerUid.
      allow create, update: if canWritePostFile(postId)
        && request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if canDeletePostFile(postId);
    }

    // Comment images. These are uploaded before the comment document, so Firestore is not read here.
    // Deletion: the uploader (ownerUid), or the post author / a global admin/owner.
    // Post deletion empties this folder via canDeletePostFile while the post document still exists.
    match /memiBoardPosts/{postId}/comment-images/{commentId}/{fileName} {
      allow get: if true;
      allow create: if isSignedIn()
        && request.resource.metadata.ownerUid == request.auth.uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn() && (
        resource.metadata.ownerUid == request.auth.uid
        || canDeletePostFile(postId)
      );
    }

    // Profile photo — the path is fixed to the uid, so only the user can write. Reads are public since it is part of the public profile.
    match /memiBoardUsers/{uid}/avatar.jpg {
      allow get: if true;
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg');
    }
  }
}
